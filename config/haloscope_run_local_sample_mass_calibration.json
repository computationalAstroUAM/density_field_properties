{
  "run_name": "haloscope_local_sample_mass_calibration",
  "paths": {
    "sim_hlist": "output/local_sample/unitsim/hlist_1.00000.list",
    "fastpm_list": "output/local_sample/fastpm/rockstar_out_nbody/out_8.list",
    "repo_root": ".",
    "output_dir": "output/local_sample_mass_calibration"
  },
  "sample": {
    "box_size_mpc_h": 200,
    "max_sim_halos": null,
    "max_fastpm_halos": null,
    "max_descriptor_batch_files": null
  },
  "mass_calibration": {
    "enabled": true,
    "method": "abundance_matching",
    "calibrated_column": "M200b_cal",
    "matching": {
      "k_neighbours": 10,
      "r_match_mpc_h": 5.0,
      "max_mass_distance": 0.95,
      "max_matching_iterations": 5
    },
    "matching_ml": {
      "train_subbox": {
        "x_min_mpc_h": 0.0,
        "x_max_mpc_h": 100.0,
        "y_min_mpc_h": 0.0,
        "y_max_mpc_h": 200.0,
        "z_min_mpc_h": 0.0,
        "z_max_mpc_h": 200.0
      },
      "ml_features": ["log10_M200b"],
      "regressor": {
        "type": "sklearn_random_forest",
        "params": { "n_estimators": 10, "max_depth": 64, "random_state": 42 }
      },
      "keep_threshold": null,
      "model_path": null,
      "write_model": false
    }
  },
  "haloscope": {
    "input_features": ["env"],
    "min_bin_size": 5,
    "run_holdout_validation": false,
    "enriched_parquet_name": "fastpm_mass_calib_placeholder.parquet"
  },
  "tidal": {
    "n_grid": 512,
    "unit_descriptors_dir": null,
    "fastpm_descriptors_dir": null
  },
  "validation": {
    "assembly_bias": {
      "enabled": false,
      "n_grid": 128
    }
  },
  "collect_tables": false
}
