{
  "run_name": "haloscope_matching_1to1_smoke",
  "paths": {
    "sim_hlist": null,
    "fastpm_list": null,
    "repo_root": ".",
    "output_dir": "output/sim_to_fastpm_haloscope_matching_1to1_smoke"
  },
  "sample": {
    "max_sim_halos": 8000,
    "max_fastpm_halos": 8000,
    "max_descriptor_batch_files": null
  },
  "mass_calibration": {
    "enabled": true,
    "method": "matching_1to1",
    "calibrated_column": "M200b_cal",
    "matching": {
      "k_neighbours": 10,
      "r_match_mpc_h": 5.0,
      "max_mass_distance": 0.95,
      "max_matching_iterations": 5
    }
  },
  "haloscope": {
    "input_features": ["env"],
    "min_bin_size": 5,
    "run_holdout_validation": true,
    "enriched_parquet_name": "fastpm_out_8_haloscope_matching_1to1_enriched.parquet"
  },
  "tidal": {
    "n_grid": 512,
    "unit_descriptors_dir": null,
    "fastpm_descriptors_dir": null
  },
  "validation": {
    "assembly_bias": {
      "enabled": false,
      "n_grid": 128
    }
  },
  "collect_tables": false
}
