{
  "run_name": "tidal_anisotropy_mn5",
  "paths": {
    "sim_hlist": "output/tidal_mn5/unit/hlist_1.00000.list",
    "fastpm_list": "output/rockstar_find_parents/fastpm_mn5_tfm/out_8_with_pid.list",
    "repo_root": ".",
    "output_dir": "output/tidal_mn5/haloscope"
  },
  "sample": {
    "box_size_mpc_h": 1000,
    "min_mass_msun_h": 3.219885e12,
    "max_mass_msun_h": null,
    "max_sim_halos": null,
    "max_fastpm_halos": null
  },
  "haloscope": {
    "input_features": ["overdensity", "tidal_anisotropy"],
    "run_holdout_validation": true,
    "min_bin_size": 9,
    "enriched_parquet_name": "fastpm_out_8_haloscope_tidal_enriched.parquet"
  },
  "tidal": {
    "n_grid": 512,
    "unit_descriptors_dir": "output/tidal_mn5/unit/tidal_anisotropy",
    "fastpm_descriptors_dir": "output/tidal_mn5/fastpm/tidal_anisotropy"
  },
  "pipeline": {
    "tidal_anisotropy": {
      "enabled": false,
      "targets": ["unit", "fastpm"],
      "unit": {
        "work_dir": "output/tidal_mn5/unit",
        "catalog_layout": "hlist"
      },
      "fastpm": {
        "work_dir": "output/tidal_mn5/fastpm",
        "catalog_layout": "rockstar_list"
      }
    },
    "preprocess": {
      "enabled": true,
      "hr_parquet_name": "halos_sim_preprocessed.parquet",
      "lr_parquet_name": "halos_fastpm_preprocessed.parquet"
    },
    "haloscope": {"enabled": true}
  },
  "validation": {
    "assembly_bias": {
      "enabled": true,
      "n_grid": 256
    },
    "holdout_corner_plots": {
      "enabled": true
    }
  }
}
